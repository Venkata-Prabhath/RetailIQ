# Optional PostgreSQL; omit to use CSV-only mode.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
DATA_SOURCE=csv
LOG_LEVEL=INFO

# Optional SMTP delivery. Keep credentials in an untracked .env or deployment secret store.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=
EMAIL_HIGH_SEVERITY_ALERTS=true
